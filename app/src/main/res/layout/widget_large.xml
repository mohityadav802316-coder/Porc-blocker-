<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/widget_large_root"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#00f0ff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIFE TRACKER • दैनिक दिनचर्या"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#94a3b8"
                android:id="@+id/widget_large_cycle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7-Day Cycle • Day 4"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#00f0ff"
            android:id="@+id/widget_large_progress_badge"
            android:background="@drawable/widget_pill_button"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="80% Done"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/widget_large_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="80"
        android:progressTint="#00f0ff"
        style="?android:attr/progressBarStyleHorizontal"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="#1b2433"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#38bdf8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CURRENT FOCUS • वर्तमान कार्य"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/widget_large_current_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Deep Study / Work Session"
            android:maxLines="1"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#94a3b8"
            android:id="@+id/widget_large_current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9:00 AM – 1:00 PM • In Progress"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">
        <TextView
            android:textSize="12sp"
            android:textColor="#64748b"
            android:ellipsize="end"
            android:id="@+id/widget_large_task1"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓ 5:00 AM — Morning Wakeup &amp; Water"
            android:maxLines="1"
            android:paddingVertical="3dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#64748b"
            android:ellipsize="end"
            android:id="@+id/widget_large_task2"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓ 6:00 AM — Workout &amp; Surya Namaskar"
            android:maxLines="1"
            android:paddingVertical="3dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#e2e8f0"
            android:ellipsize="end"
            android:id="@+id/widget_large_task3"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ 9:00 AM — Deep Study Block 1"
            android:maxLines="1"
            android:paddingVertical="3dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#94a3b8"
            android:ellipsize="end"
            android:id="@+id/widget_large_task4"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏳ 1:00 PM — Lunch &amp; Rest"
            android:maxLines="1"
            android:paddingVertical="3dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/widget_large_btn_complete"
            android:background="@drawable/widget_pill_button"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:paddingVertical="6dp">
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#00f0ff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Complete"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/widget_large_btn_meditation"
            android:background="@drawable/widget_pill_button"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:layout_marginEnd="6dp"
            android:paddingVertical="6dp">
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#38bdf8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="�� Meditate"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/widget_large_btn_open"
            android:background="@drawable/widget_pill_button"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="6dp">
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open App"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
