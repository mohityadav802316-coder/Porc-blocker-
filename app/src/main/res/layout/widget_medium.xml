<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/widget_medium_root"
    android:background="@drawable/widget_background"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingEnd="10dp">
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#00f0ff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIFE TRACKER"/>
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/widget_medium_progress_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="75%"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#94a3b8"
            android:id="@+id/widget_medium_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9/12 Done • Day 4"/>
        <ProgressBar
            android:id="@+id/widget_medium_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="75"
            android:progressTint="#00f0ff"
            style="?android:attr/progressBarStyleHorizontal"/>
    </LinearLayout>
    <FrameLayout
        android:background="#24344d"
        android:layout_width="1dp"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.4"
        android:paddingStart="12dp">
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#38bdf8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXT ACTIVITY"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/widget_medium_next_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Morning Workout"
            android:maxLines="1"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#94a3b8"
            android:id="@+id/widget_medium_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6:00 AM • In 20 mins"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/widget_medium_btn_complete"
            android:background="@drawable/widget_pill_button"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#00f0ff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Complete Next"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
