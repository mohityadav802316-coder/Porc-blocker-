<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/widget_small_root"
    android:background="@drawable/widget_background"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#00f0ff"
        android:id="@+id/widget_small_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEXT ACTIVITY • अगला कार्य"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/widget_small_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="5:00 AM"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#e2e8f0"
        android:ellipsize="end"
        android:id="@+id/widget_small_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Morning Awakening &amp; Water"
        android:maxLines="2"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#94a3b8"
        android:id="@+id/widget_small_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="In 25 minutes"/>
</LinearLayout>
