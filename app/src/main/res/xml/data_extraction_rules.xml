<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <!-- CRITICAL: Never include accountability PIN preferences in cloud backup -->
        <exclude domain="sharedpref" path="accountability_pin_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <!-- CRITICAL: Never include accountability PIN preferences in device transfer -->
        <exclude domain="sharedpref" path="accountability_pin_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
